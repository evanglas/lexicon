{
  "manifest_version": 3,
  "name": "Merriam-Webster Double Click Definitions",
  "description": "Tool to get word definition by double-clicking",
  "version": "1.0",
  "permissions": ["storage", "activeTab", "scripting"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["katex/katex.min.js", "content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "logos/logo_16.png",
      "32": "logos/logo_32.png",
      "64": "logos/logo_64.png",
      "128": "logos/logo_128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["styles.css", "secrets.json", "series.json", "dictionary_responses/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
