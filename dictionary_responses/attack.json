        "syns": [
            {
                "pl": "synonyms",
                "pt": [
                    [
                        "text",
                        "{sc}attack{/sc} {sc}assail{/sc} {sc}assault{/sc} {sc}bombard{/sc} {sc}storm{/sc} mean to make an onslaught upon. {sc}attack{/sc} implies taking the initiative in a struggle. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "plan to {it}attack{/it} the town at dawn"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}assail{/sc} implies attempting to break down resistance by repeated blows or shots. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "{it}assailed{/it} the enemy with artillery fire"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}assault{/sc} suggests a direct attempt to overpower by suddenness and violence of onslaught. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "commandos {it}assaulted{/it} the building from all sides"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}bombard{/sc} applies to attacking with bombs or shells. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "{it}bombarded{/it} the city nightly"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}storm{/sc} implies attempting to break into a defended position. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "preparing to {it}storm{/it} the fortress"
                            }
                        ]
                    ]
                ]
            }
        ],
        "et": [
            [
                "text",
                "Middle French {it}attaquer{/it}, from Old Italian {it}*estaccare{/it} to attach, from {it}stacca{/it} stake, of Germanic origin; akin to Old English {it}staca{/it}"
            ]
        ],
        "date": "circa 1576{ds|t|1||}",
        "shortdef": [
            "to set upon or work against forcefully",
            "to assail with unfriendly or bitter words",
            "to begin to affect or to act on injuriously"
        ]
    },
