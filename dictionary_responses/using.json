        "syns": [
            {
                "pl": "synonyms",
                "pt": [
                    [
                        "text",
                        "{sc}use{\/sc} {sc}employ{\/sc} {sc}utilize{\/sc} mean to put into service especially to attain an end. {sc}use{\/sc} implies availing oneself of something as a means or instrument to an end. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "willing to {it}use{\/it} any means to achieve her ends"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}employ{\/sc} suggests the use of a person or thing that is available but idle, inactive, or disengaged. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "looking for better ways to {it}employ{\/it} their skills"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}utilize{\/sc} may suggest the discovery of a new, profitable, or practical use for something. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "an old wooden bucket {it}utilized{\/it} as a planter"
                            }
                        ]
                    ]
                ]
            }
        ],
        "date": "14th century{ds|t|7||}",
        "shortdef": [
            "to put into action or service : avail oneself of : employ",
            "to expend or consume by putting to use \u2014often used with up",
            "stand"
        ]
