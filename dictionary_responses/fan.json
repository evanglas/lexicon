                        [
                            "sense",
                            {
                                "dt": [
                                    [
                                        "text",
                                        "{bc}a group of fans for a particular sport, musical group, celebrity, book or film franchise, etc. "
                                    ],
                                    [
                                        "vis",
                                        [
                                            {
                                                "t": "\u2026 the Los Angeles Lakers and the Milwaukee Bucks\u2014the last two NBA champions\u2014had {wi}fan bases{\/wi} spending the most money on team merchandise and gear.",
                                                "aq": {
                                                    "auth": "Corey Davis"
                                                }
                                            },
                                            {
                                                "t": "Yet her three albums with the Epic label failed to earn her a popular audience, beyond country\u0027s traditional {wi}fan base{\/wi} \u2026",
                                                "aq": {
                                                    "auth": "Martha A. Hostetter"
                                                }
                                            },
                                            {
                                                "t": "But sales figures don\u0027t fully capture the {wi}fan base{\/wi} among {d_link|shojo|shojo} readers, who can whip through a volume in half an hour in a bookstore and often pass along copies to friends.",
                                                "aq": {
                                                    "auth": "Sarah Glazer"
                                                }
                                            },
                                            {
                                                "t": "The fervent passion of [Justin] Bieber\u0027s {wi}fan base{\/wi} almost obscured the rampant self-indulgence of his hour-and-a-half set.",
                                                "aq": {
                                                    "auth": "Ben Fisher"
                                                }
                                            }
                                        ]
                                    ]
                                ]
                            }
                        ]
                    ]
                ]
            }
        ],
        "date": "1974",
        "shortdef": [
            "a group of fans for a particular sport, musical group, celebrity, book or film franchise, etc."
        ]
