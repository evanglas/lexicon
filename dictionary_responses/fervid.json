        "syns": [
            {
                "pl": "synonyms",
                "pt": [
                    [
                        "text",
                        "{sc}impassioned{\/sc} {sc}passionate{\/sc} {sc}ardent{\/sc} {sc}fervent{\/sc} {sc}fervid{\/sc} {sc}perfervid{\/sc} mean showing intense feeling. {sc}impassioned{\/sc} implies warmth and intensity without violence and suggests fluent verbal expression. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "an {it}impassioned{\/it} plea for justice"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}passionate{\/sc} implies great vehemence and often violence and wasteful diffusion of emotion. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "a {it}passionate{\/it} denunciation"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}ardent{\/sc} implies an intense degree of zeal, devotion, or enthusiasm. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "an {it}ardent{\/it} supporter of human rights"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}fervent{\/sc} stresses sincerity and steadiness of emotional warmth or zeal. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "{it}fervent{\/it} good wishes"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}fervid{\/sc} suggests warmly and spontaneously and often feverishly expressed emotion. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "{it}fervid{\/it} love letters"
                            }
                        ]
                    ],
                    [
                        "text",
                        " {sc}perfervid{\/sc} implies the expression of exaggerated or overwrought feelings. "
                    ],
                    [
                        "vis",
                        [
                            {
                                "t": "{it}perfervid{\/it} expressions of patriotism"
                            }
                        ]
                    ]
                ]
            }
