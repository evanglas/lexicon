                        [
                            "sense",
                            {
                                "dt": [
                                    [
                                        "text",
                                        "{bc}a {d_link|power series|power series} that gives the expansion of a function {it}f{/it} ({it}x{/it}) in the neighborhood of a point {it}a{/it} provided that in the neighborhood the function is continuous, all its derivatives exist, and the series converges to the function in which case it has the form {latex}f(x) = f(a) + \\frac{f'(a)}{1!}(x - a) + \\frac{f''(a)}{2!}(x - a)^{2} + \\dots + \\frac{f^{[n]}(a)}{n!}(x - a)^{n}{/latex} where f[{sup}{it}n{/it}{/sup}] ({it}a{/it}) is the derivative of nth order of {it}f{/it}({it}x{/it}) evaluated at {it}a{/it} "
                                    ],
                                    [
                                        "ca",
                                        {
